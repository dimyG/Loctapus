# Copy to backend/.env and fill in real values; the copy is gitignored.
# Every setting maps to a RAG_-prefixed field in backend/app/core/config.py;
# unset variables fall back to the defaults there. The file is read directly
# by the backend (when started from backend/) and injected into the compose
# api service (deploy/docker-compose.yml), where the compose environment
# block still wins.

# Opting in to real answers; the default stub provider keeps the stack offline.
#RAG_LLM_PROVIDER=groq
#RAG_GROQ_API_KEY=

# Required when running with RAG_ENVIRONMENT=production; dev defaults are rejected.
#RAG_ENVIRONMENT=production
#RAG_JWT_SECRET=
