# Stack credentials for docker compose (deploy/docker-compose.yml).
# Copy to deploy/.env next to this template; that copy is gitignored. Compose
# loads the file automatically from the project directory (the one holding
# the compose file) even when invoked with -f from the repo root.
#
# Every variable is interpolated with ${VAR:?...}, so a missing file or an
# unset value aborts `docker compose up` before anything starts. The values
# below reproduce the historical in-repo development defaults, so existing
# local volumes keep working unchanged; a public deployment (the Hetzner
# demo) must generate fresh values instead - `openssl rand -hex 32` or
# Python `secrets.token_hex(32)`.
#
# Keep usernames and passwords URL-safe (no : / @ # ?): they interpolate into
# RAG_DATABASE_URL and RAG_BROKER_URL in the compose file.

# Postgres credentials. An initialized pgdata volume keeps the credentials it
# was created with; these only apply on first start.
POSTGRES_USER=abc
POSTGRES_PASSWORD=abc
POSTGRES_DB=abc

# RabbitMQ credentials: the user the app services connect as. An initialized
# rabbitmqdata volume keeps the user it was created with.
RABBITMQ_DEFAULT_USER=abc
RABBITMQ_DEFAULT_PASS=abc

# Garage (S3). GARAGE_RPC_SECRET authenticates node-to-node RPC and is
# required even single-node (it reaches the server as an env override, so
# deploy/garage.toml no longer carries it). The DEFAULT_* triple provisions the
# app's key and bucket on first start; GARAGE_ADMIN_TOKEN guards the :3903
# admin API, which is otherwise unauthenticated. Garage binds its stored
# layout to GARAGE_DEFAULT_SECRET_KEY: never change it on an initialized
# volume - a fresh deployment must start with fresh volumes.
GARAGE_RPC_SECRET=abc
GARAGE_DEFAULT_ACCESS_KEY=abc
GARAGE_DEFAULT_SECRET_KEY=abc
GARAGE_DEFAULT_BUCKET=abc
GARAGE_ADMIN_TOKEN=abc

# Caddy site address (web service). ":8080" locally: plain HTTP, no ACME.
# A public deployment carries the demo domain instead (on the Hetzner server
# this file is rendered by the CI, so the value arrives from the
# STACK_SITE_ADDRESS secret).
SITE_ADDRESS=":8080"